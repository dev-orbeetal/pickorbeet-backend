SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=pickorbeet_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Pickorbeet <noreply@pickorbeet.com>

CORS_ALLOWED_ORIGINS=https://pickorbeet.com,https://www.pickorbeet.com,http://127.0.0.1:3777,http://localhost:3777
CORS_ALLOW_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=https://pickorbeet.com,https://www.pickorbeet.com,https://admin.pickorbeet.com,http://127.0.0.1:3777,http://localhost:3777
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False

SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=True

FRONTEND_URL=https://www.pickorbeet.com
ADMIN_PANEL_URL=https://pickorbeet.com/admin

# Steadfast courier (https://portal.packzy.com). Keys stay on the server.
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_WEBHOOK_TOKEN=
STEADFAST_TRACKING_URL=https://steadfast.com.bd/t/{code}
STEADFAST_SYNC_ORDER_STATUS=True
SHIPMENT_REFRESH_RATE=10/min

# Inbox socket (Daphne) and push worker (Celery) share this Redis.
REDIS_URL=redis://127.0.0.1:6379/0
# Absolute path to a Firebase service-account JSON. Leave empty to skip FCM.
FIREBASE_CREDENTIALS=
DEVICE_REGISTER_RATE=30/hour
