# ===========================================
# Django Server Configuration - Production
# Zzuhana E-commerce Backend (aapanel deployment)
# ===========================================

DEBUG=False

# IMPORTANT: Generate a new secret key before deploying!
# Run: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CHANGE_ME_GENERATE_A_NEW_SECRET_KEY

# Allowed Hosts - Add your server IP if needed
ALLOWED_HOSTS=www.zzuhana.com,zzuhana.com,api.zzuhana.com,localhost,127.0.0.1

# CORS Settings
CORS_ALLOWED_ORIGINS=https://www.zzuhana.com,https://zzuhana.com,https://admin.zzuhana.com
CORS_ALLOW_CREDENTIALS=True

# CSRF Settings
CSRF_TRUSTED_ORIGINS=https://www.zzuhana.com,https://zzuhana.com,https://admin.zzuhana.com,https://api.zzuhana.com
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SAMESITE=Lax

# ===========================================
# PostgreSQL Database (Create in aapanel)
# ===========================================
# Steps in aapanel:
# 1. Go to Database > PostgreSQL > Add Database
# 2. Database name: zzuhana_prod
# 3. Username: zzuhana_user
# 4. Set a strong password
# 5. Update the values below
DB_NAME=zzuhana_prod
DB_USER=zzuhana_user
DB_PASSWORD=ZzuhanaOrbeetal6546
DB_HOST=localhost
DB_PORT=5432

# ===========================================
# Email Configuration (Gmail SMTP)
# ===========================================
# To use Gmail:
# 1. Enable 2FA on your Google account
# 2. Generate an App Password: Google Account > Security > App Passwords
# 3. Use the app password below (not your regular password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

# ===========================================
# Redis (Optional - for Celery tasks)
# ===========================================
# Install Redis in aapanel: Software Store > Redis
REDIS_URL=redis://localhost:6379/1

# ===========================================
# Static & Media URLs
# ===========================================
# These are relative URLs, Nginx will serve them
MEDIA_URL=/media/
STATIC_URL=/static/

# ===========================================
# SSLCommerz Payment Gateway
# ===========================================
# Get credentials from: https://developer.sslcommerz.com/
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_SANDBOX=False

# ===========================================
# Frontend URLs
# ===========================================
FRONTEND_URL=https://zzuhana.com
ADMIN_PANEL_URL=https://admin.zzuhana.com
