# Django Server Configuration - Production
DEBUG=False
SECRET_KEY=your-very-secure-secret-key-here-change-in-production
ALLOWED_HOSTS=www.zzuhana.com,zzuhana.com,admin.zzuhana.com,your-backend-domain.com
CORS_ALLOWED_ORIGINS=https://www.zzuhana.com,https://zzuhana.com,https://admin.zzuhana.com
CORS_ALLOW_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=https://www.zzuhana.com,https://zzuhana.com,https://admin.zzuhana.com
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SAMESITE=Strict
SESSION_COOKIE_SAMESITE=Strict

# Database - Update with your production database details
DB_NAME=zzuhana_prod
DB_USER=your_prod_db_user
DB_PASSWORD=your_prod_db_password
DB_HOST=your-db-host
DB_PORT=5432

# Email Configuration - Update with your production email settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-production-email@gmail.com
EMAIL_HOST_PASSWORD=your-production-app-password

# Redis (for caching) - Update with your production Redis URL
REDIS_URL=redis://your-redis-host:6379/1

# Media Files - Update with your production storage settings
MEDIA_URL=https://your-backend-domain.com/media/
STATIC_URL=https://your-backend-domain.com/static/

# SSLCommerz - Update with your production SSLCommerz credentials
SSLCOMMERZ_STORE_ID=your_production_store_id
SSLCOMMERZ_STORE_PASSWORD=your_production_store_password
SSLCOMMERZ_SANDBOX=False

# Frontend URLs - Production URLs
FRONTEND_URL=https://zzuhana.com
ADMIN_PANEL_URL=https://admin.zzuhana.com
